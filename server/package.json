{
  "scripts": {
    "dev": "concurrently -n gateway,user,billing,generation,assessment,syllabus -c auto \"npm:dev:gateway\" \"npm:dev:user\" \"npm:dev:billing\" \"npm:dev:generation\" \"npm:dev:assessment\" \"npm:dev:syllabus\"",
    "dev:gateway": "npm --prefix gateway run dev",
    "dev:user": "npm --prefix services/user run dev",
    "dev:billing": "npm --prefix services/billing run dev",
    "dev:generation": "npm --prefix services/generation run dev",
    "dev:assessment": "npm --prefix services/assessment run dev",
    "dev:syllabus": "npm --prefix services/syllabus run dev",
    "install:all": "npm --prefix gateway install && npm --prefix services/user install && npm --prefix services/billing install && npm --prefix services/generation install && npm --prefix services/assessment install && npm --prefix services/syllabus install",
    "lint": "eslint ."
  },
  "name": "server",
  "version": "1.0.0",
  "description": "Dev tooling only. Each service in gateway/ and services/ has its own package.json and is deployed on its own.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.59.0"
  }
}
